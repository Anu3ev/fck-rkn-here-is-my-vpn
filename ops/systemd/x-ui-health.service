[Unit]
Description=Local Xray client for x-ui tunnel health checks
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=x-ui-health
Group=x-ui-health
ExecStart=/usr/local/x-ui/bin/xray-linux-amd64 run -c /etc/x-ui/tunnel-health-client.json
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
